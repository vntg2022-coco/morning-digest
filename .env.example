# Copy to .env.local and fill in. Never commit real values.
# GNEWS_API_KEY and ANTHROPIC_API_KEY are needed for `npm run digest:preview`.

# News source (GNews Essential plan, commercial use OK)
GNEWS_API_KEY=

# Summarization
ANTHROPIC_API_KEY=

# Auth + database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Protects the daily cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Temporary: until the user DB exists, the cron sends one digest here
DIGEST_TEST_TO=
DIGEST_TEST_LEVEL=intermediate
