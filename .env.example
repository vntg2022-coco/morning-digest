# Copy to .env.local and fill in. Never commit real values.
# GNEWS_API_KEY and ANTHROPIC_API_KEY are needed for `npm run digest:preview`.

# News source (GNews Essential plan, commercial use OK)
GNEWS_API_KEY=

# Summarization
ANTHROPIC_API_KEY=

# Auth + database (Supabase): Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only, bypasses row-level security
SUPABASE_SECRET_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Protects the daily cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Temporary: until the user DB exists, the cron builds content for these editions
# (learning language:level:native language, comma separated)
DIGEST_EDITIONS=es:intermediate:en
