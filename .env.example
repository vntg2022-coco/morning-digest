# Copy to .env.local and fill in. Never commit real values.
# GNEWS_API_KEY and ANTHROPIC_API_KEY are needed for `npm run digest:preview`.

# News source (GNews Essential plan, commercial use OK)
GNEWS_API_KEY=

# Summarization
ANTHROPIC_API_KEY=

# Auth + database (Supabase): Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only, bypasses row-level security
SUPABASE_SECRET_KEY=
# Personal access token (sbp_...) for `npm run db:migrate`: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Email delivery (Resend): resend.com/api-keys
RESEND_API_KEY=
# Until a domain is verified in Resend, use: Good Morning Digest <onboarding@resend.dev>
# (Resend then only delivers to your own Resend account address)
EMAIL_FROM=
# Signs the one-click unsubscribe links in emails (any long random string)
EMAIL_LINK_SECRET=
# Postal address shown in the email footer (US CAN-SPAM)
EMAIL_POSTAL_ADDRESS=

# Base URL used in email links
APP_URL=http://localhost:3000

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Protects the daily cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=
